{
  "name": "@yume-chan/puppeteer-core",
  "version": "25.16.0",
  "description": "A high-level API to control headless Chrome over the DevTools Protocol",
  "keywords": [
    "puppeteer",
    "chrome",
    "headless",
    "automation"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/puppeteer/puppeteer/tree/main/packages/puppeteer-core"
  },
  "scripts": {
    "prepack": "rollup -c rollup.config.mjs"
  },
  "files": [
    "lib",
    "src",
    "!function-fixture.mjs",
    "!*.test.ts",
    "!*.test.js",
    "!*.test.d.ts",
    "!*.test.js.map",
    "!*.test.d.ts.map",
    "!*.tsbuildinfo"
  ],
  "author": "The Chromium Authors",
  "license": "Apache-2.0",
  "dependencies": {
    "mitt": "3.0.1",
    "parsel-js": "1.2.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "urlpattern-polyfill": "10.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/chrome": "0.3.6",
    "@types/node": "^18.17.15",
    "@types/ws": "8.18.2",
    "@puppeteer/browsers": "3.2.6",
    "chromium-bidi": "157.0.8090-0",
    "devtools-protocol": "0.0.1717327",
    "typed-query-selector": "^2.12.3",
    "webdriver-bidi-protocol": "1.0.2",
    "sonda": "^0.14.0"
  }
}
