{
  "name": "@yume-chan/puppeteer-core",
  "version": "25.18.1-browser.0",
  "description": "A high-level API to control headless Chrome over the DevTools Protocol",
  "keywords": [
    "puppeteer",
    "chrome",
    "headless",
    "automation"
  ],
  "type": "module",
  "main": "./lib/puppeteer/puppeteer-core-browser.js",
  "module": "./lib/puppeteer/puppeteer-core-browser.js",
  "types": "./lib/types.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types.d.ts",
      "import": "./lib/puppeteer/puppeteer-core-browser.js",
      "require": "./lib/puppeteer/puppeteer-core-browser.js"
    },
    "./internal/*": {
      "import": "./lib/puppeteer/*",
      "require": "./lib/puppeteer/*"
    },
    "./*": {
      "import": "./*",
      "require": "./*"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/puppeteer/puppeteer/tree/main/packages/puppeteer-core"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:tsc": "wireit",
    "check": "wireit",
    "clean": "node ../../tools/clean.mjs",
    "prepack": "wireit"
  },
  "wireit": {
    "check": {
      "command": "node --experimental-strip-types tools/ensure-correct-devtools-protocol-package.mts",
      "dependencies": [
        "build"
      ]
    },
    "prepack": {
      "command": "node --experimental-strip-types ../../tools/cp.ts ../../README.md README.md",
      "files": [
        "../../README.md"
      ],
      "output": [
        "README.md"
      ]
    },
    "build:tsc": {
      "command": "hereby build:tsc",
      "clean": "if-file-deleted",
      "files": [
        "{src,third_party}/**",
        "../../versions.js",
        "!src/generated",
        "Herebyfile.mjs",
        "tsconfig.json"
      ],
      "output": [
        "lib/**"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "!function-fixture.mjs",
    "!*.test.ts",
    "!*.test.js",
    "!*.test.d.ts",
    "!*.test.js.map",
    "!*.test.d.ts.map",
    "!*.tsbuildinfo"
  ],
  "author": "The Chromium Authors",
  "license": "Apache-2.0",
  "dependencies": {
    "mitt": "3.0.1",
    "parsel-js": "1.2.3",
    "rxjs": "^7.8.2",
    "urlpattern-polyfill": "10.1.0",
    "chromium-bidi": "157.0.8090-0",
    "devtools-protocol": "0.0.1724436",
    "typed-query-selector": "^2.12.3",
    "webdriver-bidi-protocol": "1.0.2"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.2.7",
    "@types/chrome": "0.3.7",
    "@types/node": "^18.17.15",
    "@types/ws": "8.18.2",
    "hereby": "1.15.2",
    "ws": "^8.23.0",
    "wireit": "0.15.0",
    "typescript": "6.0.3"
  }
}
