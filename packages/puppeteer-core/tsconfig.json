{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "outDir": "./lib",
    "rootDir": "./",
    "types": [
      "node",
      "chrome"
    ],
    "lib":[
      "es2022",
      "DOM"
    ],
    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,
    "module": "esnext",
    "target": "es2022",
    "moduleResolution": "bundler",
    "preserveConstEnums": true
  },
  "include": [
    "src/**/*",
    "third_party/**/*"
  ],
}
